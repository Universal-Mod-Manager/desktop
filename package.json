{
  "name": "universal-mod-manager",
  "version": "0.1.1",
  "description": "",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite dev",
    "build": "vite build",
    "build:tauri": "tauri build",
    "build:web": "vite build",
    "build:plugins": "rustup target add wasm32-unknown-unknown && cargo build --release --target wasm32-unknown-unknown --manifest-path plugins/skyrim-se/Cargo.toml && cargo build --release --target wasm32-unknown-unknown --manifest-path plugins/witcher3/Cargo.toml",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "vitest",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "bits-ui": "^2.18.1",
    "lucide-svelte": "^1.0.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.11.3",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
